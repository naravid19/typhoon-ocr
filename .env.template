TYPHOON_BASE_URL=
TYPHOON_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr
TYPHOON_MAX_FILES=10
# Backend log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Max simultaneous calls to the OCR API across all files (lower if you hit 429)
TYPHOON_MAX_CONCURRENCY=3
# Client-side rate limits (Typhoon docs: typhoon-ocr = 2 req/s, 20 req/min). Default 0 = off when TYPHOON_BASE_URL is not opentyphoon.ai
# TYPHOON_RATE_LIMIT_RPS=2
# TYPHOON_RATE_LIMIT_RPM=20
