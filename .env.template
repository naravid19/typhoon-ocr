TYPHOON_BASE_URL=
TYPHOON_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr
TYPHOON_MAX_FILES=10

# --- Throughput (all optional; also editable in the app under Settings > Advanced) ---
# Client-side rate limits. Typhoon docs: typhoon-ocr = 2 req/s, 20 req/min (the default for api.opentyphoon.ai).
# Default is 0 (off) for any other TYPHOON_BASE_URL, e.g. a self-hosted vLLM. Raise them only if your logs show no 429s.
# TYPHOON_RATE_LIMIT_RPS=2
# TYPHOON_RATE_LIMIT_RPM=20
# Max simultaneous API calls across all files (default 8; the rate limit sets the pace)
# TYPHOON_MAX_CONCURRENCY=8
# max_tokens for a page's first attempt (default 4096). Pages that need more are retried with the full budget.
# TYPHOON_FIRST_PASS_MAX_TOKENS=4096
# Per-page result cache folder (default backend/.cache). Set to empty to disable caching.
# TYPHOON_CACHE_DIR=

# Backend log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
